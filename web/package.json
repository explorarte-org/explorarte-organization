    "serve:vps": "node scripts/serve-vps.mjs",
    "test:demo": "node test/mission-demo.browser.mjs",
    "test:demo:live": "node test/mission-demo.live.browser.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
