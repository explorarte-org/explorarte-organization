+def bind_question_refinement(candidate, state):
+    """Invoke the single versioned Go gate before accepting a refined task.
+
+    The model candidate is passed byte-for-byte as structured JSON. The Python
+    controller neither reproduces semantic rules nor copies candidate prose
+    into the authorized task; only the Go component may return that task.
+    """
+    if not QUESTION_IDENTITY_GATE_BIN or not QUESTION_IDENTITY_GATE_SHA256:
+        raise MandateHalt("instrument_regression",
+                          "question identity gate path/hash is not configured")
+    if not os.path.isfile(QUESTION_IDENTITY_GATE_BIN):
+        raise MandateHalt("instrument_regression",
+                          f"question identity gate missing: {QUESTION_IDENTITY_GATE_BIN}")
+    with open(QUESTION_IDENTITY_GATE_BIN, "rb") as gate_file:
+        actual_sha = hashlib.sha256(gate_file.read()).hexdigest()
+    if actual_sha != QUESTION_IDENTITY_GATE_SHA256:
+        raise MandateHalt("instrument_regression",
+                          f"question identity gate SHA mismatch: {actual_sha} != "
+                          f"{QUESTION_IDENTITY_GATE_SHA256}")
+    payload = json.dumps(candidate, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    try:
+        proc = subprocess.run(
+            [QUESTION_IDENTITY_GATE_BIN], input=payload, capture_output=True,
+            timeout=15, check=False,
+        )
+    except (OSError, subprocess.SubprocessError) as exc:
+        raise MandateHalt("instrument_regression",
+                          f"question identity gate execution failed: {exc}") from exc
+    if proc.returncode != 0:
+        raise MandateHalt("instrument_regression",
+                          "question identity gate returned operational failure "
+                          f"rc={proc.returncode}: {proc.stderr.decode('utf-8', 'replace')[:300]}")
+    try:
+        outcome = json.loads(proc.stdout)
+    except Exception as exc:
+        raise MandateHalt("instrument_regression",
+                          f"question identity gate emitted invalid JSON: {exc}") from exc
+    if outcome.get("canonical_contract_sha256") != QUESTION_IDENTITY_CONTRACT_SHA256:
+        raise MandateHalt("instrument_regression",
+                          "question identity gate returned unexpected contract identity")
+    if outcome.get("controller_binding_schema") != QUESTION_IDENTITY_BINDING_SCHEMA:
+        raise MandateHalt("instrument_regression",
+                          "question identity gate returned unexpected binding schema")
+    decision = outcome.get("decision") or {}
+    allowed = outcome.get("provider_call_allowed") is True
+    accepted = (decision.get("status") == "ACCEPT_IDENTITY_PRESERVED" and
+                decision.get("disposition") == "ACCEPT_IDENTITY_PRESERVED")
+    if allowed != accepted:
+        raise MandateHalt("instrument_regression",
+                          "question identity gate decision/provider permission mismatch")
+    if allowed and not isinstance(outcome.get("authorized_task"), dict):
+        raise MandateHalt("instrument_regression",
+                          "accepted refinement has no controller-owned authorized task")
+    if not allowed and outcome.get("authorized_task") is not None:
+        raise MandateHalt("instrument_regression",
+                          "rejected refinement unexpectedly returned an authorized task")
+    state["question_identity_gate_provenance"] = {
+        "binary_path": QUESTION_IDENTITY_GATE_BIN,
+        "binary_sha256": actual_sha,
+        "canonical_contract_sha256": QUESTION_IDENTITY_CONTRACT_SHA256,
+        "binding_schema": QUESTION_IDENTITY_BINDING_SCHEMA,
+    }
+    return outcome
+
