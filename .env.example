ORG_APP_NAME=explorarte-organization
ORG_ENVIRONMENT=development
ORG_HTTP_ADDR=:8080
# Host-side loopback port used by Docker Compose.
ORG_HTTP_PORT=8080
ORG_HTTP_READ_HEADER_TIMEOUT=5s
ORG_HTTP_READ_TIMEOUT=15s
ORG_HTTP_WRITE_TIMEOUT=30s
ORG_HTTP_IDLE_TIMEOUT=60s
ORG_SHUTDOWN_TIMEOUT=15s
ORG_LOG_LEVEL=info
ORG_LOG_FORMAT=json

# Replace every placeholder before docker compose up.
ORG_POSTGRES_ADMIN_USER=explorarte_admin
ORG_POSTGRES_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
ORG_POSTGRES_DATABASE=explorarte_org
ORG_POSTGRES_USER=explorarte_app
ORG_POSTGRES_PASSWORD=replace-with-a-different-long-random-app-password

ORG_DATABASE_MAX_CONNS=8
ORG_DATABASE_MIN_CONNS=1
ORG_DATABASE_MAX_CONN_LIFETIME=30m
ORG_DATABASE_MAX_CONN_IDLE_TIME=5m
ORG_DATABASE_HEALTH_CHECK_PERIOD=30s
ORG_DATABASE_CONNECT_TIMEOUT=5s
ORG_DATABASE_PING_TIMEOUT=2s
ORG_DATABASE_STATEMENT_TIMEOUT=30s
ORG_DATABASE_LOCK_TIMEOUT=5s
ORG_DATABASE_AUTO_MIGRATE=true
ORG_DATABASE_MIGRATION_TIMEOUT=45s
ORG_DATABASE_MIGRATION_RETRY=5s

# Canonical registry is copied read-only into the image.
ORG_CANONICAL_DIR=/opt/explorarte/docs/canonical
ORG_REGISTRY_SYNC_TIMEOUT=30s

# Durable PostgreSQL task engine. orgd reconciles state only; it never executes tasks.
ORG_TASK_ORGANIZATION_ID=explorarte
ORG_TASK_RECONCILER_ENABLED=true
ORG_TASK_RECONCILE_INTERVAL=5s
ORG_TASK_RECONCILE_BATCH_SIZE=100
ORG_TASK_DEFAULT_MAX_ATTEMPTS=5
ORG_TASK_DEFAULT_LEASE_DURATION=2m
ORG_TASK_MAX_LEASE_DURATION=15m
ORG_TASK_RETRY_BASE_DELAY=5s
ORG_TASK_RETRY_MAX_DELAY=10m
ORG_TASK_OUTBOX_MAX_ATTEMPTS=10
ORG_TASK_OUTBOX_CLAIM_DURATION=1m
ORG_TASK_COMMAND_TIMEOUT=30s

# Safe staging engine. Disabled by default. orgd only reconciles metadata when enabled;
# all Git mutation commands are executed explicitly through orgctl in a controlled toolchain.
ORG_STAGING_ENABLED=false
ORG_STAGING_REPOSITORIES_FILE=/etc/explorarte/repositories.yaml
ORG_STAGING_WORKSPACE_ROOT=/var/lib/explorarte/staging/workspaces
ORG_STAGING_ARTIFACT_ROOT=/var/lib/explorarte/staging/artifacts
ORG_STAGING_QUARANTINE_ROOT=/var/lib/explorarte/staging/quarantine
ORG_STAGING_COMMAND_TIMEOUT=2m
ORG_STAGING_MAX_ARTIFACT_BYTES=67108864
ORG_STAGING_MAX_CHANGED_FILES=500
ORG_STAGING_STALE_AFTER=30m
ORG_STAGING_RECONCILE_INTERVAL=30s
ORG_STAGING_RECONCILE_BATCH_SIZE=100
ORG_STAGING_GIT_BINARY=git

# Model control plane. Provider adapters are independently disabled by default.
# false still permits registry validation/status and durable reads.
ORG_MODEL_RUNTIME_ENABLED=false
ORG_MODEL_RUNTIME_COMMAND_TIMEOUT=30s
ORG_MODEL_RUNTIME_GLOBAL_CONCURRENCY=4
ORG_MODEL_RUNTIME_MAX_RESPONSE_BYTES=1048576
ORG_MODEL_RUNTIME_MAX_TOOL_INTENTS=8
ORG_MODEL_RUNTIME_CLAIM_TTL=2m
ORG_MODEL_RUNTIME_RECONCILE_BATCH_SIZE=100

# Branch 10 dispatcher assignment locator. It is non-secret and is not itself
# authentication; empty unless this process dispatches.
ORG_MODEL_EXECUTION_PRINCIPAL_KEY=
# Branch 11 cryptographic execution identity. When enabled for dispatch, the
# key file must be an absolute path to one Ed25519 PKCS#8 PEM private key and
# must not grant group/other access (normally mode 0600).
ORG_MODEL_EXECUTION_IDENTITY_ENABLED=false
ORG_MODEL_EXECUTION_IDENTITY_KEY_FILE=

# Branch 12 openai-compatible Chat Completions adapter. Disabled by default.
# Endpoint must be HTTPS and end in /v1/chat/completions. The credential file
# contains a bearer token, is outside the repository, and must be mode 0600.
ORG_MODEL_PROVIDER_OPENAI_COMPATIBLE_ENABLED=false
ORG_MODEL_PROVIDER_OPENAI_COMPATIBLE_ENDPOINT_URL=
ORG_MODEL_PROVIDER_OPENAI_COMPATIBLE_CREDENTIAL_FILE=
ORG_MODEL_PROVIDER_OPENAI_COMPATIBLE_REQUEST_TIMEOUT=2m
ORG_MODEL_PROVIDER_OPENAI_COMPATIBLE_CIRCUIT_FAILURE_THRESHOLD=5
ORG_MODEL_PROVIDER_OPENAI_COMPATIBLE_CIRCUIT_OPEN_DURATION=30s

# Branch 21 Alibaba Token Plan via Claude Code CLI adapter. Compiled support
# does NOT grant productive egress: docs/canonical/model-egress-policy.yaml
# remains the authority and currently denies Alibaba traffic. Enable only in a
# controlled environment after validating plan/provider usage terms.
# The executable and dedicated settings JSON are pinned by SHA-256. The
# settings file contains ANTHROPIC_AUTH_TOKEN and must be private (0600).
ORG_MODEL_PROVIDER_ALIBABA_CLAUDE_ENABLED=false
ORG_MODEL_PROVIDER_ALIBABA_CLAUDE_EXECUTABLE=/usr/local/bin/claude
ORG_MODEL_PROVIDER_ALIBABA_CLAUDE_EXPECTED_VERSION=
ORG_MODEL_PROVIDER_ALIBABA_CLAUDE_EXECUTABLE_SHA256=
ORG_MODEL_PROVIDER_ALIBABA_CLAUDE_SETTINGS_FILE=/run/secrets/alibaba-claude-settings.json
ORG_MODEL_PROVIDER_ALIBABA_CLAUDE_SETTINGS_SHA256=
ORG_MODEL_PROVIDER_ALIBABA_CLAUDE_TOKEN_PLAN_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic
ORG_MODEL_PROVIDER_ALIBABA_CLAUDE_WORK_DIR=/var/lib/explorarte/alibaba-claude
ORG_MODEL_PROVIDER_ALIBABA_CLAUDE_RUNTIME_PATH=/usr/local/bin:/usr/bin:/bin
ORG_MODEL_PROVIDER_ALIBABA_CLAUDE_REQUEST_TIMEOUT=2m
ORG_MODEL_PROVIDER_ALIBABA_CLAUDE_KILL_GRACE=3s
ORG_MODEL_PROVIDER_ALIBABA_CLAUDE_MAX_STDERR_BYTES=65536
ORG_MODEL_PROVIDER_ALIBABA_CLAUDE_MAX_CONCURRENCY=2

# Branch 13 persistent cell worker (`orgctl model worker run`). Dispatches as
# ORG_MODEL_EXECUTION_PRINCIPAL_KEY; holds no state of its own. Not started
# by orgd — run as its own process.
ORG_MODEL_WORKER_BATCH_SIZE=10
ORG_MODEL_WORKER_CONCURRENCY=1
ORG_MODEL_WORKER_MIN_BACKOFF=1s
ORG_MODEL_WORKER_MAX_BACKOFF=1m
ORG_MODEL_WORKER_SHUTDOWN_GRACE=30s
ORG_MODEL_ASSIGNMENT_DEFAULT_TTL=15m
ORG_MODEL_ASSIGNMENT_MAX_TTL=24h
ORG_MODEL_ASSIGNMENT_EXPIRE_BATCH_SIZE=100
